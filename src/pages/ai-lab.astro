---
import Base from '../layouts/Base.astro';
const items = [
  { t: 'Local RAG', d: 'Ollama + ChromaDB + LangChain over my own knowledge base (second brain in Obsidian).' },
  { t: 'Agents', d: 'Multi-agent orchestration with LangGraph to automate triage and analysis tasks.' },
  { t: 'MCP', d: 'Custom MCP servers to connect enterprise tools with models.' },
  { t: 'Automation', d: 'n8n for workflows between AI, data, and notifications.' },
];
---
<Base title="AI Lab" description="Applied AI experiments and projects: LLMs, RAG, agents, and MCP.">
  <section class="mx-auto max-w-6xl px-6 py-16">
    <p class="kicker">~/ai-lab</p>
    <h1 class="mt-2 text-3xl font-bold text-white md:text-4xl">AI <span class="gradient-text">Lab</span></h1>
    <p class="mt-3 max-w-2xl text-slate-400">Where I test and document LLMs, RAG, agents, and AI automation before turning them into portfolio projects.</p>
    <div class="reveal mt-10 divide-y divide-white/10 rounded-lg border border-white/10 bg-white/[0.02]">
      {items.map((i) => (
        <div class="flex flex-col gap-1 px-6 py-5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8">
          <p class="font-medium text-white sm:w-40 sm:shrink-0">{i.t}</p>
          <p class="text-sm text-slate-400">{i.d}</p>
        </div>
      ))}
    </div>
    <p class="mt-10 text-sm text-slate-500">See full projects in the <a href="/portfolio" class="text-accent hover:underline">portfolio</a>.</p>
  </section>
</Base>
