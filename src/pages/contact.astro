---
import Base from '../layouts/Base.astro';
---
<Base title="Contact" description="Get in touch with César Darío Aguilar.">
  <section class="mx-auto max-w-2xl px-6 py-16">
    <p class="kicker">~/contact</p>
    <h1 class="mt-2 text-3xl font-bold text-white md:text-4xl">Contact</h1>
    <p class="mt-3 text-slate-400">Want to talk about a remote role or a project? Reach out directly — a contact form is on the way.</p>
    <div class="reveal mt-8 divide-y divide-white/10 rounded-lg border border-white/10 bg-white/[0.02]">
      <div class="flex items-baseline justify-between gap-6 px-6 py-4">
        <p class="mono text-xs uppercase tracking-widest text-slate-500">Email</p>
        <a href="mailto:cda.admin@aigis-cloud.com" class="text-accent hover:underline">cda.admin@aigis-cloud.com</a>
      </div>
      <div class="flex items-baseline justify-between gap-6 px-6 py-4">
        <p class="mono text-xs uppercase tracking-widest text-slate-500">GitHub</p>
        <a href="https://github.com/cd-aguilar" target="_blank" rel="noopener" class="text-accent hover:underline">github.com/cd-aguilar</a>
      </div>
      <div class="flex items-baseline justify-between gap-6 px-6 py-4">
        <p class="mono text-xs uppercase tracking-widest text-slate-500">LinkedIn</p>
        <a href="https://www.linkedin.com/in/cesar-dario-aguilar-a0324b15/" target="_blank" rel="noopener" class="text-accent hover:underline">linkedin.com/in/cesar-dario-aguilar-a0324b15</a>
      </div>
    </div>
  </section>
</Base>
