---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import Base from '../layouts/Base.astro';

const resumeExists = existsSync(fileURLToPath(new URL('../../public/resume.pdf', import.meta.url)));
---
<Base title="Resume" description="César Darío Aguilar's resume — AI Engineer / Blue Team.">
  <section class="mx-auto max-w-3xl px-6 py-16">
    <p class="kicker">~/resume</p>
    <h1 class="mt-2 text-3xl font-bold text-white md:text-4xl">Resume</h1>
    <p class="mt-3 text-slate-400">Chemical engineer transitioning into AI Engineering and Cybersecurity Blue Team.</p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      {resumeExists ? (
        <a href="/resume.pdf" class="btn-primary">Download PDF</a>
      ) : (
        <span class="badge !border-white/15 !bg-white/5 !text-slate-400">PDF coming soon</span>
      )}
      <a href="https://www.linkedin.com/in/cesar-dario-aguilar-ai/" target="_blank" rel="noopener" class="btn-secondary">View LinkedIn</a>
    </div>
  </section>
</Base>
