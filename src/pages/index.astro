---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const focus = [
  { title: 'Cloud Security', detail: 'AWS, GCP, IAM, Terraform, security hardening.' },
  { title: 'Detection Engineering', detail: 'Threat detection, threat hunting, DFIR, MITRE ATT&CK.' },
  { title: 'AI Engineering', detail: 'LLMs, RAG, agents, MCP, LangChain, Ollama.' },
];
---
<Base title="AI & Cloud Security Engineer">
  <section class="relative overflow-hidden pb-20 pt-20 md:pt-28">
    <div class="relative mx-auto grid max-w-6xl gap-12 px-6 md:grid-cols-[1.2fr_1fr] md:items-center">
      <div class="reveal">
        <span class="badge">
          <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
          Open to remote AI / Security roles
        </span>
        <h1 class="mt-5 max-w-2xl text-4xl font-extrabold leading-tight text-white md:text-6xl">
          AI & <span class="gradient-text">Cloud Security</span> Engineer
        </h1>
        <p class="mt-6 max-w-xl text-lg text-slate-300">
          Chemical engineer transitioning into Cloud Security, Detection Engineering, and Security
          Automation — with an AI Engineering specialization. I build things to learn them
          properly, documented in the open.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/portfolio" class="btn-primary">View portfolio</a>
          <a href="/resume" class="btn-secondary">View resume</a>
        </div>
      </div>
      <div class="reveal overflow-hidden rounded-lg border border-white/10 bg-white/[0.03]">
        <div class="mono flex items-center gap-1.5 border-b border-white/10 px-4 py-2.5 text-xs text-slate-500">
          <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
          <span class="ml-2">whoami.sh</span>
        </div>
        <div class="mono space-y-1.5 p-5 text-sm leading-relaxed">
          <p><span class="text-accent">$</span> whoami</p>
          <p class="text-slate-300">&gt; César Darío Aguilar</p>
          <p><span class="text-accent">$</span> role</p>
          <p class="text-accent2">&gt; AI & Cloud Security Engineer</p>
          <p><span class="text-accent">$</span> stack</p>
          <p class="text-slate-400">&gt; RAG · LangChain · Elastic · MITRE ATT&amp;CK</p>
          <p><span class="text-accent">$</span> status</p>
          <p class="text-accent">&gt; available for remote work_</p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-white/[0.02] py-14">
    <div class="mx-auto grid max-w-6xl divide-y divide-white/10 px-6 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      {focus.map((f) => (
        <div class="reveal px-0 py-6 sm:px-8 sm:py-0">
          <h2 class="text-lg font-semibold text-white">{f.title}</h2>
          <p class="mt-2 text-sm text-slate-400">{f.detail}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="reveal mb-8 flex items-end justify-between">
      <div>
        <p class="kicker">Selected work</p>
        <h2 class="mt-2 text-2xl font-bold text-white">Featured projects</h2>
      </div>
      <a href="/portfolio" class="text-sm text-accent hover:underline">View all →</a>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {projects.map((p, i) => (
        <a
          href={`/portfolio/${p.slug}`}
          class:list={['group card reveal', { 'card-featured': i === 0 }]}
        >
          <h3 class="font-semibold text-white group-hover:text-accent">{p.data.title}</h3>
          <p class="mt-2 text-sm text-slate-400">{p.data.summary}</p>
          <p class="mono mt-4 text-xs text-slate-500">{p.data.stack.join(' · ')}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
