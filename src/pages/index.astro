---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const focus = [
  { title: 'AI Engineering', detail: 'LLMs, RAG, agents, MCP, LangChain, Ollama.' },
  { title: 'Blue Team', detail: 'Threat detection, threat hunting, DFIR, MITRE ATT&CK.' },
  { title: 'Cloud', detail: 'AWS, GCP, Docker, Kubernetes, Terraform.' },
];
---
<Base title="AI Engineer & Blue Team">
  <section class="mx-auto max-w-6xl px-6 pb-20 pt-20 md:pt-28">
    <p class="mono text-sm uppercase tracking-widest text-accent">César Darío Aguilar</p>
    <h1 class="mt-4 max-w-3xl text-4xl font-extrabold leading-tight text-white md:text-6xl">
      AI Engineer with a <span class="text-accent">Cybersecurity Blue Team</span> focus
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-slate-300">
      Chemical engineer transitioning into AI, Cloud, and cybersecurity. I build AI agents,
      RAG pipelines, and threat detection labs — documented in the open.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/portfolio" class="rounded-md bg-accent px-5 py-3 font-medium text-ink transition hover:bg-accent/90">View portfolio</a>
      <a href="/resume" class="rounded-md border border-white/20 px-5 py-3 font-medium text-white transition hover:border-accent/50">View resume</a>
    </div>
  </section>

  <section class="border-y border-white/10 bg-white/[0.02] py-16">
    <div class="mx-auto grid max-w-6xl gap-8 px-6 md:grid-cols-3">
      {focus.map((f) => (
        <div>
          <h2 class="text-lg font-semibold text-white">{f.title}</h2>
          <p class="mt-2 text-sm text-slate-400">{f.detail}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="mb-8 flex items-end justify-between">
      <h2 class="text-2xl font-bold text-white">Featured projects</h2>
      <a href="/portfolio" class="text-sm text-accent hover:underline">View all →</a>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {projects.map((p) => (
        <a href={p.data.repo} target="_blank" rel="noopener" class="group rounded-lg border border-white/10 p-6 transition hover:border-accent/40 hover:bg-white/[0.03]">
          <h3 class="font-semibold text-white group-hover:text-accent">{p.data.title}</h3>
          <p class="mt-2 text-sm text-slate-400">{p.data.summary}</p>
          <p class="mono mt-4 text-xs text-slate-500">{p.data.stack.join(' · ')}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
