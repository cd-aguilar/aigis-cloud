---
import Base from '../layouts/Base.astro';
const services = [
  { t: 'AI Automation', d: 'Workflows and agents that cut down repetitive manual work.' },
  { t: 'LLM & RAG Solutions', d: 'AI assistants built over an organization’s own knowledge.' },
  { t: 'Detection Engineering', d: 'Detection rules, threat hunting, and incident response.' },
  { t: 'Cloud Security', d: 'Architecture and hardening on AWS / GCP.' },
];
---
<Base title="Services" description="AI, automation, and cybersecurity services (coming soon).">
  <section class="mx-auto max-w-6xl px-6 py-16">
    <p class="kicker">~/services</p>
    <h1 class="mt-2 text-3xl font-bold text-white md:text-4xl">Services</h1>
    <p class="mt-3 max-w-2xl text-slate-400">
      Available soon as an independent consultancy. Today, available for full-time remote roles —
      see <a href="/resume" class="text-accent hover:underline">resume</a>.
    </p>
    <div class="reveal mt-10 divide-y divide-white/10 rounded-lg border border-white/10 bg-white/[0.02]">
      {services.map((s) => (
        <div class="flex flex-col gap-1 px-6 py-5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8">
          <p class="font-medium text-white sm:w-56 sm:shrink-0">{s.t}</p>
          <p class="text-sm text-slate-400">{s.d}</p>
        </div>
      ))}
    </div>
  </section>
</Base>
