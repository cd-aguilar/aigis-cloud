# Copiar a .env y completar si se agregan integraciones (ej. formulario de contacto,
# analytics). No hay variables requeridas para build/dev por ahora.

# --- Formulario de contacto (InsForge) — ver docs/ADR/0003-insforge-contact-form.md ---
# Hostname del proyecto InsForge (no es secreto, visible en el dashboard > Instalar > Conexión directa).
INSFORGE_BASE_URL=https://i8w4sqcw.us-east.insforge.app
# Service Key de InsForge (SECRETO — dashboard > Instalar > Conexión directa > Claves de API).
# Solo se usa server-side (este endpoint corre en el Worker, nunca en el browser), por eso es
# seguro usar la Service Key en vez de la Anon Key. NUNCA commitear el valor real.
INSFORGE_SERVICE_KEY=
